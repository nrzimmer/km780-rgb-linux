# Third-party binaries: DO NOT version. They are reproducible from the
# official installers (see docs/06-binaries.md) and weigh ~486 MB.
external/gds/**
!external/gds/
!external/gds/*.txt

# Ghidra project and venv
ghidra-proj/
venv/

# Firmware and recovery-kit binaries: they are G.SKILL's, not ours to
# redistribute. Re-extractable from the official installer (docs/06-binaries.md).
# Only the .md documentation stays versioned.
firmware/**
!firmware/
!firmware/recovery/
!firmware/**/*.md

# Keyboard state (machine-specific)
backup-matrix*.json
snap-*.json

# Windows session transcript: 22 MB, it is scrollback, not evidence.
# Stays on disk but out of the index.
sessions/

# Python cache
__pycache__/
*.pyc

# experiment-log backup
backup-exp.json
backup-first-contact.json
physical-matrix.json
